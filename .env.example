# Verbindung zum Nexus ERP (Public API v1)
# Key anlegen: Nexus > Einstellungen > API-Keys (nur Administratoren)
# Benoetigte Berechtigungen: artikel:read, kunden:read, belege:write
NEXUS_URL=https://erp.example.de
NEXUS_API_KEY=nxk_bitte_ersetzen

# Lokaler Web-Server (npm start)
HOST=127.0.0.1
PORT=3210
# Pflicht, sobald HOST nicht localhost ist (HTTP Basic Auth, Benutzername beliebig)
# KALKBOT_PASSWORT=
# Erlaubte Host-Header bei HOST != localhost, kommagetrennt (Schutz gegen DNS-Rebinding)
# KALKBOT_HOSTS=kalkulation.intern:3210

# Kalkulationsparameter – Beispielwerte, an die eigene Betriebsabrechnung anpassen.
# Werte in der Kalkulationsdatei ("parameter") haben Vorrang.
KALK_LOHNKOSTENSATZ=45
KALK_ZUSCHLAG_MATERIAL=15
KALK_ZUSCHLAG_LOHN=60
KALK_ZUSCHLAG_FREMDLEISTUNG=10
KALK_WAGNIS_GEWINN=10
KALK_STEUERSATZ=19
# Warnung, wenn der Deckungsbeitrag darunter liegt (in % vom Netto, 0 = aus)
KALK_MINDESTMARGE=0
